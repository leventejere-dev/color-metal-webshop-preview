{
  "name": "color-metal-webshop-preview",
  "private": true,
  "version": "0.1.0",
  "description": "Prototip frontend (React + Vite + TypeScript) pentru webshopul Color Metal – semifabricate metalice configurabile.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:pages": "cross-env BASE_PATH=/color-metal-webshop-preview/ npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "images": "node tools/prepare-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.0"
  }
}
